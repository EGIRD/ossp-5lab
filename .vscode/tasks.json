{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Server and Client (MinGW)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17", "-O2", "-Wall",
        "lab05-network/src/server/server.cpp",
        "-o", "lab05-network/server.exe",
        "-lws2_32"
      ],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Build Client (MinGW)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17", "-O2", "-Wall",
        "lab05-network/src/client/client.cpp",
        "-o", "lab05-network/client.exe",
        "-lws2_32"
      ],
      "group": "build"
    }
  ]
}