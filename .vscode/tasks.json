{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Server (MinGW)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17", "-O2", "-Wall",
        "src/server/server.cpp",
        "-o", "server.exe",
        "-lws2_32"
      ],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Build Client (MinGW)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17", "-O2", "-Wall",
        "src/client/client.cpp",
        "-o", "client.exe",
        "-lws2_32"
      ],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}